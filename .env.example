# Database
DATABASE_URL=postgresql+asyncpg://agrobot:agrobot@db:5432/weather_alerts_api
# DATABASE_URL_SYNC is derived automatically from DATABASE_URL — do not set it here

# API connection pool (async engine — FastAPI)
# Total API connections = (DB_POOL_SIZE + DB_MAX_OVERFLOW) × api_processes
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Worker connection pool (sync engine — Celery)
# Workers run one task at a time (prefetch=1) so a small pool is enough.
# Total worker connections = (DB_WORKER_POOL_SIZE + DB_WORKER_MAX_OVERFLOW) × num_workers
DB_WORKER_POOL_SIZE=2
DB_WORKER_MAX_OVERFLOW=3

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0

# Alert Evaluator
ALERT_EVAL_INTERVAL_SECONDS=3600
ALERT_LOOKAHEAD_DAYS=7
ALERT_RENOTIFY_DELTA=0.10
ALERT_EVAL_BATCH_SIZE=500

# App
ENV=development
LOG_LEVEL=INFO
