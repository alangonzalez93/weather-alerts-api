# Database
DATABASE_URL=postgresql+asyncpg://agrobot:agrobot@db:5432/weather_alerts_api
# DATABASE_URL_SYNC is derived automatically from DATABASE_URL — do not set it here

# Pool sizing — tune per environment to stay within postgres max_connections
# Total connections ≈ (DB_POOL_SIZE + DB_MAX_OVERFLOW) × number_of_processes
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Alert Evaluator
ALERT_EVAL_INTERVAL_SECONDS=3600
ALERT_LOOKAHEAD_DAYS=7
ALERT_RENOTIFY_DELTA=0.10

# App
ENV=development
LOG_LEVEL=INFO
